# Prana — environment variables (copy to .env and fill in)

# OpenAI (used by the routing LLM in api/routing.py)
OPENAI_API_KEY=

# Stripe (optional — only needed if you exercise checkout flows)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Telegram bot (used by api/telegram_bot.py)
TELEGRAM_BOT_TOKEN=REDACTED_TOKEN_REVOKED
# uAgents / Agentverse (optional)
AGENTVERSE_API_KEY=
PRANA_SEED=

# Other
GEMINI_API_KEY=
BROWSER_USE_API_KEY=
